{
  "name": "hippocampus",
  "version": "0.4.1",
  "description": "Open-source MCP memory server with SQLCipher encryption",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "sync-agents": "tsx scripts/sync-agents.ts"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "sqlite",
    "encryption"
  ],
  "author": "Karolina Sarna",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3-multiple-ciphers": "^11.0.0",
    "dotenv": "^16.4.0",
    "hono": "^4.12.30",
    "ml-matrix": "^6.12.1",
    "zod": "^3.23.0"
  },
  "overrides": {
    "@hono/node-server": "$@hono/node-server",
    "sharp": "^0.35.0",
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  }
}
