# Hippocampus restore drill config (D27). Copy to /etc/hippocampus-drill/drill.env on the
# DRILL HOST (never the hippo box):  chmod 600. Placeholders only here.

# Where results go: drill.log (one dated line per run) and last-<mode>.
DRILL_STATE=/var/lib/hippocampus-drill

# The DRILL private key lives here, and only here. The recovery key is not on this host.
# Under /var/lib, not /etc: ProtectSystem=full makes /etc read-only, and gpg must write
# lock files and its agent socket into GNUPGHOME.
GNUPGHOME=/var/lib/hippocampus-drill/gnupg

# The database passphrase (HIPPO_PASSPHRASE), one line, chmod 600. The drill needs it to
# open the restored file; it reaches the scratch container by env NAME, never argv.
HIPPO_PASSPHRASE_FILE=/etc/hippocampus-drill/passphrase

# Same Storage Box sub-account as the backup, with this host's own key installed on it.
BACKUP_REMOTE=uNNNNNN-subN@uNNNNNN.your-storagebox.de:./
BACKUP_SSH_KEY=/etc/hippocampus-drill/storagebox_ed25519
BACKUP_SSH_PORT=23
BACKUP_KNOWN_HOSTS=/etc/hippocampus-drill/storagebox_known_hosts

DRILL_IMAGE=hippo-drill:latest
# The nightly backup fires once a day; 30h leaves room for one late run, not a missed one.
FRESH_MAX_HOURS=30

# ops-kit's notify.sh (the one notifier; no second sink). Its own env names:
NOTIFY=/opt/ops-kit/bin/notify.sh
# ALERT_WEBHOOK_URL=http://127.0.0.1:2586/<topic>
# ALERT_WEBHOOK_TOKEN=
# NOTIFY_FORMAT=ntfy
