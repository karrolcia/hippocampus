# Hippocampus nightly backup config (D27). Copy to /etc/hippocampus/backup.env on the
# hippo box:  install -d -m 700 /etc/hippocampus && chmod 600 /etc/hippocampus/backup.env
# Read by hippo-backup.service (infra/backup/hippo-backup.sh). Placeholders only here.

# The two PUBLIC keys each bundle is encrypted to (full fingerprints, space-separated):
# the RECOVERY key (private half only in the password manager) and the DRILL key
# (private half only on the drill host). No private key belongs on this box.
GPG_RECIPIENTS="RECOVERYFINGERPRINT0000000000000000000000 DRILLFINGERPRINT000000000000000000000000"
# Under /var/lib, not /etc: the unit runs with ProtectSystem=full (/etc read-only) and gpg
# writes lock files and its agent socket into GNUPGHOME.
GNUPGHOME=/var/lib/hippocampus-backup/gnupg

# Offsite target: a Hetzner Storage Box SUB-ACCOUNT of its own (base dir `hippocampus`),
# never another app's. SSH/rsync on port 23. The host key is pinned in the known_hosts
# file below (ssh-keyscan once, check the fingerprint against the Hetzner console).
BACKUP_REMOTE=uNNNNNN-subN@uNNNNNN.your-storagebox.de:./
BACKUP_SSH_KEY=/etc/hippocampus/storagebox_ed25519
BACKUP_SSH_PORT=23
BACKUP_KNOWN_HOSTS=/etc/hippocampus/storagebox_known_hosts

# Local staging + retention. A bundle is kept if it is among the newest RETENTION OR
# younger than RETENTION_DAYS (union: the count alone changes meaning if the timer
# cadence changes). One run a night: 14 + 14 = two weeks. Offsite, a bundle is deleted
# only when THIS box expires it (offsite first, then locally, so a failed night retries),
# never by a blanket --delete, so a rebuilt box with an empty staging dir cannot wipe
# the offsite history.
# Space: ~15-20 MB per bundle at the October 2026 size, ~300 MB for 14.
BACKUP_STAGING=/var/backups/hippocampus
RETENTION=14
RETENTION_DAYS=14

CONTAINER=hippocampus
